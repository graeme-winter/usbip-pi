# USB/IP server side only; the Pi exports, it does not import.
CONFIG_USBIP_CORE=m
CONFIG_USBIP_HOST=m
# CONFIG_USBIP_VHCI_HCD is not set
# CONFIG_USBIP_DEBUG is not set

# Hardware watchdog, kicked by systemd (see system.conf.d/watchdog.conf)
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# USB serial drivers for ports published through ser2net
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
