#!/bin/sh
# usbip-export BUSID
#
# Bind a USB device to usbip-host if devices.conf routes it to "usbip".
# Run by usbip-export@BUSID.service, which udev starts on hotplug.
set -eu

# shellcheck source=board/rpi4-usbip/rootfs-overlay/usr/lib/usbip-pi/policy.sh
. "${USBPI_LIB:-/usr/lib/usbip-pi}/policy.sh"
USBIP=${USBIP:-usbip}

busid=${1:?usage: usbip-export BUSID}
dev=$USBPI_SYSFS/$busid

policy_lookup "$busid" || { echo "$busid: gone"; exit 0; }
what="$busid ($POLICY_ID)"

# Hubs carry the topology; exporting one would take its children with it.
if [ "$(cat "$dev/bDeviceClass" 2>/dev/null)" = 09 ]; then
    echo "$what: hub, not exported"
    exit 0
fi

if [ -L "$dev/driver" ] && \
   [ "$(basename "$(readlink "$dev/driver")")" = usbip-host ]; then
    echo "$what: already exported"
    exit 0
fi

case $POLICY_ACTION in
    usbip)
        modprobe usbip-host 2>/dev/null || true
        "$USBIP" bind -b "$busid"
        echo "$what: exported over USB/IP"
        ;;
    serial)
        echo "$what: kept local for ser2net (devices.conf line $POLICY_LINE)"
        ;;
    *)
        echo "$what: ignored"
        ;;
esac
