#!/bin/sh
# ser2net-gen                    write /run/ser2net/ser2net.yaml (ExecStartPre)
# ser2net-gen --link TTY         print TTY's /dev link name (udev PROGRAM)
#
# Every "serial" rule in devices.conf gets its ser2net connections up
# front, one per TCP port in its range, each opening the stable link
# /dev/serial/by-tcp/<port> when a client connects. udev creates that link
# when a matching tty appears (interface N -> first port + N) and drops it
# on unplug; a client connecting while the device is absent is told so
# and disconnected.
#
# So ser2net never needs reloading. That matters: in ser2net 4.3.8 a
# SIGHUP while any client is connected makes ser2net abort when that
# client later disconnects (fixed upstream in 4.6.7, commit 7cc838f).
# Edits to devices.conf take effect on "systemctl restart ser2net".
set -eu

# shellcheck source=board/rpi4-usbip/rootfs-overlay/usr/lib/usbip-pi/policy.sh
. "${USBPI_LIB:-/usr/lib/usbip-pi}/policy.sh"
TTYS=${USBPI_TTYS:-/sys/class/tty}
DEV=${USBPI_DEV:-/dev}
OUT=${SER2NET_CONF:-/run/ser2net/ser2net.yaml}

syslog='' tty=''
case ${1:-} in
    '') ;;
    --link) tty=${2:?--link needs a tty name}; syslog=1 ;;
    *) echo "usage: ser2net-gen [--link TTY]" >&2; exit 2 ;;
esac

# Under udev stdout is captured; send diagnostics to syslog (the journal).
log() {
    if [ -n "$syslog" ]; then "${LOGGER:-logger}" -t ser2net-gen -- "$*"
    else echo "$*" >&2; fi
}

# port_range SPEC: set FIRST and LAST from "4001" or "4010-4013".
port_range() {
    case $1 in
        *[!0-9-]*|''|-*|*-|*-*-*) return 1 ;;
        *-*) FIRST=${1%-*} LAST=${1#*-} ;;
        *)   FIRST=$1 LAST=$1 ;;
    esac
    [ "$FIRST" -ge 1 ] && [ "$LAST" -ge "$FIRST" ] && [ "$LAST" -le 65535 ]
}

valid_mode() {
    case $1 in raw|rfc2217|telnet) return 0 ;; *) return 1 ;; esac
}

if [ -n "$tty" ]; then
    [ -e "$TTYS/$tty/device" ] || exit 1
    d=$(readlink -f "$TTYS/$tty/device")
    while [ -n "$d" ]; do               # walk up to the interface, e.g. 1-1.3:1.0
        case ${d##*/} in [0-9]*-*:*.*) break ;; esac
        d=${d%/*}
    done
    [ -n "$d" ] || exit 1
    iface=${d##*/}
    busid=${iface%%:*}
    ifnum=$((0x$(cat "$d/bInterfaceNumber")))
    policy_lookup "$busid" || exit 1
    [ "$POLICY_ACTION" = serial ] || exit 1
    what="$busid ($POLICY_ID) $tty"
    if ! port_range "$POLICY_TCPPORT" || ! valid_mode "$POLICY_MODE"; then
        log "$what: devices.conf line $POLICY_LINE is invalid, not published"
        exit 1
    fi
    port=$((FIRST + ifnum))
    if [ "$port" -gt "$LAST" ]; then
        log "$what: interface $ifnum -> TCP $port is outside $POLICY_TCPPORT" \
            "(devices.conf line $POLICY_LINE); widen the range to publish it"
        exit 1
    fi
    # Two devices matching one rule would claim the same port; first wins.
    held=$DEV/serial/by-tcp/$port
    if [ -L "$held" ]; then
        other=$(basename "$(readlink "$held")")
        if [ "$other" != "$tty" ] && [ -e "$TTYS/$other" ]; then
            log "$what: TCP $port already used by $other (two devices" \
                "matching one serial rule?)"
            exit 1
        fi
    fi
    log "$what -> TCP $port"
    echo "serial/by-tcp/$port"
    exit 0
fi

# Generate the full configuration from devices.conf.
mkdir -p "${OUT%/*}"
tmp=$(mktemp "$OUT.XXXXXX")
{
    cat <<YAML
%YAML 1.1
---
# Generated by ser2net-gen from $USBPI_CONF at ser2net start; do not edit.
default:
  name: kickolduser
  value: true
  class: ser2net
YAML
    n=0 used=' '
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line=${line%%#*}
        set -f
        # shellcheck disable=SC2086
        set -- $line
        set +f
        [ "${1:-}" = serial ] || continue
        spec=${3:-} settings=${4:-9600n81,local} mode=${5:-raw}
        if ! port_range "$spec"; then
            log "devices.conf line $n: bad or missing TCP port '$spec', skipped"
            continue
        fi
        if ! valid_mode "$mode"; then
            log "devices.conf line $n: bad mode '$mode', skipped"
            continue
        fi
        case $mode in
            raw)     proto=tcp ;;
            rfc2217) proto='telnet(rfc2217),tcp' ;;
            telnet)  proto='telnet,tcp' ;;
        esac
        port=$FIRST
        while [ "$port" -le "$LAST" ]; do
            case $used in
                *" $port "*)
                    log "devices.conf line $n: TCP $port already used by an" \
                        "earlier rule, skipped" ;;
                *)
                    used="$used$port "
                    cat <<YAML

connection: &port$port
  accepter: $proto,$port
  connector: serialdev,$DEV/serial/by-tcp/$port,$settings
  options:
    kickolduser: true
YAML
                    ;;
            esac
            port=$((port + 1))
        done
    done < "$USBPI_CONF"
} > "$tmp"
chmod 644 "$tmp"
mv "$tmp" "$OUT"
