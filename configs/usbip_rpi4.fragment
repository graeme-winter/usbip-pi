# Appended to Buildroot's configs/raspberrypi4_64_defconfig by build.sh,
# so kernel/firmware/toolchain pins track the Buildroot release in use.

BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches $(BR2_EXTERNAL_USBIP_PI_PATH)/patches"

BR2_TARGET_GENERIC_HOSTNAME="usbip-pi"
BR2_TARGET_GENERIC_ISSUE="USB/IP appliance"

# systemd for udev -> unit activation; read-only root, /var on tmpfs
BR2_INIT_SYSTEMD=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_INIT_SYSTEMD_VAR_FACTORY=y

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_USBIP_PI_PATH)/board/rpi4-usbip/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypi4-64/post-build.sh $(BR2_EXTERNAL_USBIP_PI_PATH)/board/rpi4-usbip/post-build.sh"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_USBIP_PI_PATH)/board/rpi4-usbip/linux.fragment"

BR2_PACKAGE_USBIP=y
BR2_PACKAGE_HWDATA=y
BR2_PACKAGE_HWDATA_USB_IDS=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_SER2NET=y

# Onboard Ethernet is named end0 with current systemd, not eth0
BR2_SYSTEM_DHCP="end0"

BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
